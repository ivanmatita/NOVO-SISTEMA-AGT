# =========================
# SUPABASE (Obrigatório)
# =========================

# URL do Projeto Supabase (mesmo valor em VITE_ e sem VITE_ para o backend)
VITE_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# Chave pública Anon (segura para o browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ SEGREDO — NÃO adicionar como VITE_* — nunca exposta ao browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =========================
# SEGURANÇA / JWT
# =========================

# Segredo JWT (mínimo 32 caracteres — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=GERE_UM_SEGREDO_FORTE_AQUI_MIN_32_CHARS

# Ambiente
NODE_ENV=production

# URL pública da aplicação (usado para redirecionamentos e CORS)
VITE_APP_URL=https://seu-projeto.vercel.app

# =========================
# AGT - FACTURAÇÃO ELECTRÓNICA
# =========================

# Credenciais AGT (NUNCA expor no frontend — sem VITE_)
AGT_USERNAME=
AGT_PASSWORD=

# URL AGT (HOMOLOGAÇÃO - TESTE)
AGT_VALIDATION_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1/validarDocumento

# OU PRODUÇÃO (descomentar quando estiver em produção)
# AGT_VALIDATION_URL=https://sifp.minfin.gov.ao/sigt/fe/v1/validarDocumento

# =========================
# SOFTWARE INFO (AGT)
# =========================
AGT_SOFTWARE_INFO_DETAIL={"productId":"IMATEC SOFT ERP","productVersion":"1.0.0","softwareValidationNumber":"C_134"}

# =========================
# CHAVES RSA (ASSINATURA AGT)
# =========================

AGT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----"
AGT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nSUA_CHAVE_PUBLICA_AQUI\n-----END PUBLIC KEY-----"

# =========================
# CONFIGURAÇÃO AGT
# =========================

# Modo AGT (LIVE para servidores reais ou SANDBOX para simulação local)
VITE_AGT_MODE=SANDBOX

# Timeout pedidos AGT (ms)
AGT_TIMEOUT=15000

# Número de tentativas automáticas
AGT_RETRY_COUNT=3

# =========================
# IA (OPCIONAL)
# =========================
GEMINI_API_KEY=sua_chave_aqui
