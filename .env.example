# Identificador do Ambiente (production | staging | development)
VITE_APP_ENV=development
NODE_ENV=development
VITE_APP_URL=http://localhost:3000

# =========================
# SUPABASE
# =========================
# URL do Projeto Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# Chave pública Anon (browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...

# Segredo Service Role (backend apenas)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# =========================
# AGT - FACTURAÇÃO ELECTRÓNICA
# =========================
# Credenciais AGT
AGT_USERNAME=TESTE
AGT_PASSWORD=

# URL AGT Homologação
AGT_VALIDATION_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1/validarDocumento

# Modo AGT (LIVE para servidores reais ou SANDBOX para simulação local)
VITE_AGT_MODE=SANDBOX
AGT_TIMEOUT=15000
AGT_RETRY_COUNT=3
