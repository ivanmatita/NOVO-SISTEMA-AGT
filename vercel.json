{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api-agt-nif/(.*)",
      "destination": "https://portaldocontribuinte.minfin.gov.ao/$1"
    },
    {
      "source": "/api/health/(.*)",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth-saas.js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth-saas.js"
    },
    {
      "source": "/api/exercicios-fiscais",
      "destination": "/api/exercicios-fiscais.js"
    },
    {
      "source": "/api/config-empresa",
      "destination": "/api/config-empresa.js"
    },
    {
      "source": "/api/licencas/(.*)",
      "destination": "/api/licencas.js"
    },
    {
      "source": "/api/licencas",
      "destination": "/api/licencas.js"
    },
    {
      "source": "/api/migracao/(.*)",
      "destination": "/api/migracao.js"
    },
    {
      "source": "/api/migracao",
      "destination": "/api/migracao.js"
    },
    {
      "source": "/api/stats",
      "destination": "/api/stats.js"
    },
    {
      "source": "/api/secure-clientes/(.*)",
      "destination": "/api/secure-clientes.js"
    },
    {
      "source": "/api/secure-clientes",
      "destination": "/api/secure-clientes.js"
    },
    {
      "source": "/api/secure-locais-trabalho",
      "destination": "/api/secure-locais-trabalho.js"
    },
    {
      "source": "/api/invoices/:id/(.*)",
      "destination": "/api/invoices.js"
    },
    {
      "source": "/api/invoices/:id",
      "destination": "/api/invoices.js"
    },
    {
      "source": "/api/invoices",
      "destination": "/api/invoices.js"
    },
    {
      "source": "/api/secure-locais-trabalho/(.*)",
      "destination": "/api/secure-locais-trabalho.js"
    },
    {
      "source": "/api/system-users",
      "destination": "/api/system-users.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/health.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS,PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ]
}
